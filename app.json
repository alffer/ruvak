{
  "expo": {
    "name": "RUVAK",
    "slug": "ruvak",
    "scheme": "ruvak",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17191D",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ruvak.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#17191D"
      }
    },
    "web": {
      "name": "RUVAK",
      "shortName": "RUVAK",
      "output": "single",
      "themeColor": "#17191D",
      "backgroundColor": "#17191D",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17191D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}

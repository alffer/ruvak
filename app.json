{
  "expo": {
    "name": "RUVAK",
    "slug": "ruvak",
    "scheme": "ruvak",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17191D",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ruvak.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "RUVAK",
      "shortName": "RUVAK",
      "output": "single",
      "themeColor": "#17191D",
      "backgroundColor": "#17191D"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font", "expo-image"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
